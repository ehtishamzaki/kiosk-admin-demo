<Window x:Class="KioskAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kiosk Admin Panel"
        Width="1100" Height="720" MinWidth="900" MinHeight="600"
        Background="White"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Ink}" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DeviceNameText" Text="Device" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DeviceSerialText" Text="Serial" Foreground="#AEB8C4" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="NetworkStatusText" Text="Network: unknown" Foreground="White" Margin="0,0,24,0" />
                    <TextBlock x:Name="PrinterStatusText" Text="Printer: none" Foreground="White" Margin="0,0,24,0" />
                    <TextBlock x:Name="ClockText" Text="--:--" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Border x:Name="LockPanel" Background="{StaticResource Panel}">
                <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center" Background="White" Padding="28" CornerRadius="6" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Administrator access" Style="{StaticResource H1}" Margin="0,0,0,6" />
                        <TextBlock Text="Enter the device administration PIN to configure Wi-Fi and printers." Style="{StaticResource Hint}" Margin="0,0,0,18" />
                        <PasswordBox x:Name="PinBox" MaxLength="12" KeyDown="PinBox_KeyDown" />
                        <TextBlock x:Name="PinMessage" Style="{StaticResource Hint}" Foreground="{StaticResource Danger}" Margin="0,8,0,12" Text="" />
                        <Button x:Name="UnlockButton" Content="Unlock" Click="UnlockButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Border>

            <Grid x:Name="AdminPanel" Visibility="Collapsed" Margin="20,14,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Device administration" Style="{StaticResource H1}" VerticalAlignment="Center" />
                    <Button Content="Lock" Style="{StaticResource Secondary}" HorizontalAlignment="Right" Click="LockButton_Click" Margin="0" />
                </Grid>

                <TabControl Grid.Row="1" x:Name="Tabs" BorderBrush="{StaticResource Line}">
                    <TabItem Header="Wi-Fi">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="ScanButton" Content="Scan" Click="ScanButton_Click" />
                                <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource Secondary}" Click="DisconnectButton_Click" />
                                <TextBlock x:Name="WifiStatusText" VerticalAlignment="Center" Style="{StaticResource Hint}" Text="" />
                            </StackPanel>
                            <ListView Grid.Row="1" x:Name="WifiList" SelectionChanged="WifiList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Network" Width="320" DisplayMemberBinding="{Binding Ssid}" />
                                        <GridViewColumn Header="Signal" Width="90" DisplayMemberBinding="{Binding SignalLabel}" />
                                        <GridViewColumn Header="dBm" Width="70" DisplayMemberBinding="{Binding Rssi}" />
                                        <GridViewColumn Header="Security" Width="160" DisplayMemberBinding="{Binding Security}" />
                                        <GridViewColumn Header="" Width="120" DisplayMemberBinding="{Binding ConnectedLabel}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Password" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <PasswordBox Grid.Column="1" x:Name="WifiPasswordBox" />
                                <Button Grid.Column="2" x:Name="ConnectButton" Content="Connect" Margin="10,0,0,0" Click="ConnectButton_Click" IsEnabled="False" />
                                <TextBlock Grid.Column="3" x:Name="WifiResultText" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Hint}" Text="" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Printers">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="RefreshPrintersButton" Content="Refresh" Click="RefreshPrintersButton_Click" />
                                <Button x:Name="SetAppDefaultButton" Content="Use for reports" Click="SetAppDefaultButton_Click" IsEnabled="False" />
                                <Button x:Name="SetWindowsDefaultButton" Content="Set as Windows default" Style="{StaticResource Secondary}" Click="SetWindowsDefaultButton_Click" IsEnabled="False" />
                                <TextBlock x:Name="PrinterMessageText" VerticalAlignment="Center" Style="{StaticResource Hint}" Text="" />
                            </StackPanel>
                            <ListView Grid.Row="1" x:Name="PrinterList" SelectionChanged="PrinterList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Printer" Width="340" DisplayMemberBinding="{Binding Name}" />
                                        <GridViewColumn Header="Type" Width="80" DisplayMemberBinding="{Binding Kind}" />
                                        <GridViewColumn Header="Status" Width="220" DisplayMemberBinding="{Binding Status}" />
                                        <GridViewColumn Header="Jobs" Width="60" DisplayMemberBinding="{Binding Jobs}" />
                                        <GridViewColumn Header="Default" Width="130" DisplayMemberBinding="{Binding DefaultLabel}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="320" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Add network printer" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="NetworkPrinterBox" Text="\\print-server\Reception-Laser" />
                                <Button Grid.Column="2" Content="Add" Margin="10,0,0,0" Click="AddNetworkPrinterButton_Click" />
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Print report">
                        <Grid Margin="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="NewReportButton" Content="New sample report" Style="{StaticResource Secondary}" Click="NewReportButton_Click" />
                                <Button x:Name="PrintButton" Content="Print" Click="PrintButton_Click" />
                                <TextBlock x:Name="PrintTargetText" VerticalAlignment="Center" Style="{StaticResource Hint}" Text="" />
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Padding="20">
                                <TextBox x:Name="ReportPreview" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto" />
                            </Border>
                            <TextBlock Grid.Row="2" x:Name="PrintResultText" Margin="0,10,0,0" Style="{StaticResource Hint}" Text="" />
                        </Grid>
                    </TabItem>

                    <TabItem Header="Log">
                        <Grid Margin="14">
                            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource Line}" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,6">
            <TextBlock x:Name="FooterText" Style="{StaticResource Hint}" Text="" />
        </Border>
    </Grid>
</Window>
